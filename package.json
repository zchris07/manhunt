{
  "name": "manhunt",
  "version": "0.1.0",
  "private": true,
  "description": "MANHUNT: a browser-based, top-down 2D asymmetric multiplayer horror game.",
  "type": "module",
  "workspaces": [
    "shared",
    "host",
    "client"
  ],
  "scripts": {
    "dev": "npm run dev -w @manhunt/client",
    "dev:local": "node scripts/dev-local.mjs",
    "signal": "node scripts/signal-server.mjs",
    "build": "npm run build -w @manhunt/client",
    "preview": "npm run preview -w @manhunt/client",
    "typecheck": "tsc -p shared --noEmit && tsc -p host --noEmit && tsc -p client --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "balance": "vitest run --config vitest.balance.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "1.56.1",
    "@types/node": "^22.10.0",
    "eslint": "^9.39.0",
    "globals": "^16.0.0",
    "peer": "^1.0.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "~8.46.4",
    "vite": "^7.3.0",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20"
  }
}
